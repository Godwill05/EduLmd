{
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "css:build": "tailwindcss -i resources/css/edulmd.css -o public/assets/css/edulmd.css --minify",
        "css:watch": "tailwindcss -i resources/css/edulmd.css -o public/assets/css/edulmd.css --watch",
        "css:sync": "npm run css:build && node tools/check-collisions.js && cp public/assets/css/edulmd.css assets/css/edulmd.css && cp public/assets/js/edulmd-ui.js assets/js/edulmd-ui.js && cp public/assets/js/edulmd-shell.js assets/js/edulmd-shell.js",
        "check:collisions": "node tools/check-collisions.js"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.20",
        "axios": "^1.1.2",
        "laravel-vite-plugin": "^0.7.2",
        "lodash": "^4.17.19",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "vite": "^4.0.0"
    },
    "dependencies": {
        "playwright-core": "^1.65.1"
    }
}
